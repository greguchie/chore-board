{
  "info": {
    "name": "Chore Board API",
    "description": "End-to-end tests for the chore-board API. Run the whole collection in order against a running server. It creates its own data and deletes it again at the end.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "ownerId",
      "value": ""
    },
    {
      "key": "secondUserId",
      "value": ""
    },
    {
      "key": "boardId",
      "value": ""
    },
    {
      "key": "ownerMemberId",
      "value": ""
    },
    {
      "key": "secondMemberId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Health",
      "item": [
        {
          "name": "GET /health",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"API and database are up\", () => pm.response.to.have.status(200));",
                  "pm.test(\"status is ok\", () => pm.expect(pm.response.json().status).to.eql(\"ok\"));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. Users",
      "item": [
        {
          "name": "Create the owner user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"Owner-{{runId}}@Example.com\",\n  \"displayName\": \"Owner User\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runId\", Date.now().toString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User created\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "pm.test(\"response has an id and no password fields\", () => {",
                  "  pm.expect(user).to.have.property(\"id\");",
                  "  pm.expect(user).to.not.have.property(\"password\");",
                  "  pm.expect(user).to.not.have.property(\"passwordHash\");",
                  "  pm.expect(user).to.not.have.property(\"password_hash\");",
                  "});",
                  "pm.test(\"email is stored in lowercase\", () => pm.expect(user.email).to.eql(user.email.toLowerCase()));",
                  "if (user.id) pm.collectionVariables.set(\"ownerId\", user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create the second user",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"second-{{runId}}@example.com\",\n  \"displayName\": \"Second User\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"User created\", () => pm.response.to.have.status(201));",
                  "const user = pm.response.json();",
                  "if (user.id) pm.collectionVariables.set(\"secondUserId\", user.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duplicate email is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"owner-{{runId}}@example.com\",\n  \"displayName\": \"Copy\",\n  \"password\": \"password123\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Duplicate email returns 409\", () => pm.response.to.have.status(409));"
                ]
              }
            }
          ]
        },
        {
          "name": "Invalid input is rejected",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"not-an-email\",\n  \"displayName\": \"\",\n  \"password\": \"short\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Invalid input returns 400\", () => pm.response.to.have.status(400));",
                  "pm.test(\"lists the problems\", () => pm.expect(pm.response.json().details).to.be.an(\"array\").that.is.not.empty);"
                ]
              }
            }
          ]
        },
        {
          "name": "List users",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"list contains the owner\", () => {",
                  "  const ids = pm.response.json().map((u) => u.id);",
                  "  pm.expect(ids).to.include(pm.collectionVariables.get(\"ownerId\"));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Get one user",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/{{ownerId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{ownerId}}"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"returns the right user\", () => pm.expect(pm.response.json().id).to.eql(pm.collectionVariables.get(\"ownerId\")));"
                ]
              }
            }
          ]
        },
        {
          "name": "Unknown user returns 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/users/00000000-0000-4000-8000-000000000000",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "00000000-0000-4000-8000-000000000000"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unknown user returns 404\", () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        },
        {
          "name": "Update a user",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{secondUserId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "users",
                "{{secondUserId}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Renamed Second User\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const user = pm.response.json();",
                  "pm.test(\"name changed and updatedAt moved forward\", () => {",
                  "  pm.expect(user.displayName).to.eql(\"Renamed Second User\");",
                  "  pm.expect(new Date(user.updatedAt).getTime()).to.be.above(new Date(user.createdAt).getTime());",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
