    {
      "name": "5. Tasks",
      "item": [
        {
          "name": "Create a task with an assignee and due date",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/tasks",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "tasks"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Take out the trash\",\n  \"assigneeId\": \"{{secondMemberId}}\",\n  \"dueDate\": \"2026-10-30\"\n}",
              "options": {
