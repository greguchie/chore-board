          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Member added\", () => pm.response.to.have.status(201));",
                  "const member = pm.response.json();",
                  "pm.test(\"role defaults to member\", () => pm.expect(member.role).to.eql(\"member\"));",
                  "if (member.id) pm.collectionVariables.set(\"secondMemberId\", member.id);"
