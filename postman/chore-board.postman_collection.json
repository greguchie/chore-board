    {
      "name": "4. Members",
      "item": [
        {
          "name": "List members (owner was added automatically)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "members"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "const list = pm.response.json();",
                  "pm.test(\"the owner is the only member\", () => {",
                  "  pm.expect(list).to.have.length(1);",
                  "  pm.expect(list[0].role).to.eql(\"owner\");",
                  "});",
                  "if (list.length) pm.collectionVariables.set(\"ownerMemberId\", list[0].id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Add the second user as a member",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/boards/{{boardId}}/members",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "boards",
                "{{boardId}}",
                "members"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userId\": \"{{secondUserId}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
